        "path": "solution.mjs",
        "content": "export function startupSafe(dep) {\n  // TODO : depends_on seul ne garantit que l'ORDRE, pas la disponibilité\n  return dep.condition === 'started';\n}\n"
      }
    ]
  },
  "reference": {
    "solution.mjs": "export function startupSafe(dep) {\n  return !!dep.hasHealthcheck && dep.condition === 'service_healthy';\n}\n"
  },
  "tests": [
    {
      "id": "t1",
      "name": "healthcheck + service_healthy → déterministe",
      "kind": "call-equals",
      "export": "startupSafe",
      "args": [
        {
          "hasHealthcheck": true,
          "condition": "service_healthy"
        }
      ],
      "expected": true
    },
    {
      "id": "t2",
      "name": "depends_on 'started' seul → course au démarrage",
      "kind": "call-equals",
      "export": "startupSafe",
      "args": [
        {
          "hasHealthcheck": false,
          "condition": "started"
        }
      ],
      "expected": false
    },
    {
      "id": "t3",
