{
  "id": "azure-insecure",
  "title": "Azure — architecture non sécurisée",
  "provider": "azure",
  "region": "eastus",
  "description": "Stockage public, credentials statiques, VM unique sans observabilité : passer à une identité managée, un stockage privé et une architecture résiliente.",
  "need": "Supprimer les credentials statiques et l'exposition publique.",
  "constraints": [
    "identités managées",
    "stockage privé"
  ],
  "zones": [
    {
      "id": "zone-1",
      "label": "Zone 1"
    },
    {
      "id": "zone-2",
      "label": "Zone 2"
    }
  ],
  "resources": [
    {
      "id": "client",
      "kind": "client",
      "label": "Client"
    },
    {
      "id": "vm",
      "kind": "vm",
      "label": "VM (unique)",
      "zone": "zone-1"
    },
    {
      "id": "blob",
      "kind": "object-storage",
      "label": "Blob (public)",
      "public": true
    },
    {
      "id": "db",
      "kind": "managed-db",
      "label": "Azure SQL",
      "zone": "zone-1",
      "props": {
        "managed": true
      }
    }
  ],
  "edges": [
    {
      "id": "c-vm",
      "from": "client",
      "to": "vm",
      "kind": "routes-to",
      "props": {
        "tls": true
      }
    },
    {
      "id": "vm-blob",
      "from": "vm",
      "to": "blob",
      "kind": "writes"
    },
    {
      "id": "vm-db",
      "from": "vm",
      "to": "db",
      "kind": "writes"
    }
  ],
  "identities": [
    {
      "id": "app-user",
      "type": "user",
      "staticKeys": true,
      "policies": [
        {
          "actions": [
            "storage:*"
          ],
          "resources": [
            "*"
          ],
          "effect": "allow"
        }
      ]
    }
  ],
  "observability": {},
  "skills": [
    "linux",
    "debugging"
  ],
  "dayRefs": [
    79,
    85
  ],
  "trackScope": [
    "appsec-cloud-security-v1"
  ],
  "playbookRef": "cloud-credentials-compromised",
  "missionRefs": [
    "cloud-secure-architecture"
  ],
  "fixedResources": [
    {
      "id": "client",
      "kind": "client",
      "label": "Client"
    },
    {
      "id": "agw",
      "kind": "load-balancer",
      "label": "Load Balancer",
      "zone": "zone-1",
      "props": {
        "managed": true
      }
    },
    {
      "id": "app-1",
      "kind": "container",
      "label": "App 1",
      "zone": "zone-1"
    },
    {
      "id": "app-2",
      "kind": "container",
      "label": "App 2",
      "zone": "zone-2"
    },
    {
      "id": "blob",
      "kind": "object-storage",
      "label": "Blob (privé)",
      "public": false
    },
    {
      "id": "db",
      "kind": "managed-db",
      "label": "Azure SQL (HA)",
      "zone": "zone-1",
      "props": {
        "managed": true,
        "backup": true
      }
    },
    {
      "id": "backup",
      "kind": "backup",
      "label": "Sauvegardes",
      "props": {
        "restoreTested": true
      }
    },
    {
      "id": "mon",
      "kind": "monitoring",
      "label": "Azure Monitor"
    }
  ],
  "fixedEdges": [
    {
      "id": "c-agw",
      "from": "client",
      "to": "agw",
      "kind": "routes-to",
      "props": {
        "tls": true
      }
    },
    {
      "id": "agw-1",
      "from": "agw",
      "to": "app-1",
      "kind": "routes-to"
    },
    {
      "id": "agw-2",
      "from": "agw",
      "to": "app-2",
      "kind": "routes-to"
    },
    {
      "id": "a1-blob",
      "from": "app-1",
      "to": "blob",
      "kind": "writes"
    },
    {
      "id": "a1-db",
      "from": "app-1",
      "to": "db",
      "kind": "writes"
    },
    {
      "id": "a2-db",
      "from": "app-2",
      "to": "db",
      "kind": "writes"
    },
    {
      "id": "bk-db",
      "from": "backup",
      "to": "db",
      "kind": "backs-up"
    }
  ],
  "fixedIdentities": [
    {
      "id": "app-identity",
      "type": "managed-identity",
      "policies": [
        {
          "actions": [
            "storage:read",
            "storage:write"
          ],
          "resources": [
            "blob"
          ],
          "effect": "allow"
        }
      ]
    }
  ],
  "fixedObservability": {
    "logs": true,
    "metrics": true
  }
}
