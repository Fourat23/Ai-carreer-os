      {
        "path": "index.html",
        "readOnly": true,
        "content": "<!doctype html>\n<html lang=\"fr\">\n<head><meta charset=\"utf-8\"></head>\n<body>\n  <button id=\"switch\" type=\"button\">Basculer</button>\n  <span id=\"state\">éteint</span>\n</body>\n</html>\n"
      },
      {
        "path": "app.js",
        "content": "const sw = document.getElementById('switch');\nconst state = document.getElementById('state');\n// TODO : au clic, mets « allumé » dans #state.\n"
      }
    ]
  },
  "reference": {
    "app.js": "const sw = document.getElementById('switch');\nconst state = document.getElementById('state');\nsw.addEventListener('click', () => { state.textContent = 'allumé'; });\n"
  },
  "tests": [
    {
      "id": "t1",
