  "reference": {
    "solution.mjs": "export function criticalPath(jobs){const byId=new Map(jobs.map(j=>[j.id,j]));const memo=new Map();function longest(id){if(memo.has(id))return memo.get(id);const j=byId.get(id);const deps=(j.needs||[]).filter(d=>byId.has(d));const best=deps.length?Math.max(...deps.map(longest)):0;const v=best+(j.duration||0);memo.set(id,v);return v;}return jobs.length?Math.max(...jobs.map(j=>longest(j.id))):0;}"
  },
