{
  "id": "overprivileged-rbac",
  "title": "RBAC trop permissif (wildcard)",
  "description": "Un ClusterRole accorde « * » sur les verbes et ressources, lié au ServiceAccount par défaut. Objectif : appliquer le moindre privilège et corriger le binding.",
  "domain": "rbac",
  "difficulty": 3,
  "incident": "access-compromise",
  "playbookRef": "excessive-permissions",
  "artifacts": [
    {
      "id": "role",
      "kind": "rbac",
      "path": "rbac/role.json",
      "content": {
        "kind": "ClusterRole",
        "scopeHint": "namespace",
        "rules": [
          {
            "apiGroups": [
              "*"
            ],
            "resources": [
              "*"
            ],
            "verbs": [
              "*"
            ]
          }
        ]
      }
    },
    {
      "id": "binding",
      "kind": "rbac",
      "path": "rbac/binding.json",
      "content": {
        "kind": "ClusterRoleBinding",
        "roleRef": "admin-everything",
        "subjectServiceAccount": "default"
      }
    }
  ],
