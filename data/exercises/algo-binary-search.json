  "reference": {
    "solution.mjs": "export function binarySearch(arr, target){ let lo=0, hi=arr.length-1; while(lo<=hi){ const mid=(lo+hi)>>1; if(arr[mid]===target) return mid; if(arr[mid]<target) lo=mid+1; else hi=mid-1; } return -1; }"
  },
