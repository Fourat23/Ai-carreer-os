    { "id": "db-replica", "kind": "relational-db", "label": "Base réplica", "zone": "az-b", "environment": "production", "props": { "public": false, "persistent": true } },
    { "id": "secrets", "kind": "secret-store", "label": "Coffre à secrets", "environment": "production" },
    { "id": "backup", "kind": "backup", "label": "Sauvegarde", "props": { "restoreTested": true } },
    { "id": "monitoring", "kind": "monitoring", "label": "Observabilité" }
  ],
  "edges": [
    { "id": "d1", "from": "client", "to": "dns", "kind": "resolves", "props": { "tls": true } },
