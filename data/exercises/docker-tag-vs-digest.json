  "tests": [
    {
      "id": "t1",
      "name": "digest épinglé → true",
      "kind": "call-equals",
      "export": "isReproducible",
      "args": [
        "node:20@sha256:abcdef123456"
      ],
      "expected": true
    },
    {
      "id": "t2",
      "name": "latest → false",
      "kind": "call-equals",
      "export": "isReproducible",
      "args": [
        "node:latest"
      ],
      "expected": false
    },
    {
      "id": "t3",
      "name": "tag version → false",
      "kind": "call-equals",
      "export": "isReproducible",
      "args": [
        "python:3.12-alpine"
      ],
      "expected": false
    },
    {
      "id": "t4",
      "name": "digest sans tag (privé)",
      "kind": "call-equals",
