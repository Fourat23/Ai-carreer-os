  "reference": {
    "solution.py": "import pandas as pd\n\ndef drop_columns(rows):\n    df = pd.DataFrame(rows)\n    n = len(df)\n    out = []\n    for c in df.columns:\n        nu = df[c].nunique(dropna=False)\n        if nu <= 1 or nu == n:\n            out.append(c)\n    return sorted(out)\n"
  },
