        "content": "import pandas as pd\n\ndef skewed(train, serve, tol):\n    # TODO: colonnes num. communes dont |mean_train-mean_serve|>tol, triées.\n    return []\n"
      }
    ]
  },
  "reference": {
    "solution.py": "import pandas as pd\n\ndef skewed(train, serve, tol):\n    a = pd.DataFrame(train).select_dtypes('number')\n    b = pd.DataFrame(serve).select_dtypes('number')\n    out = []\n    for c in a.columns:\n        if c in b.columns and abs(a[c].mean() - b[c].mean()) > tol:\n            out.append(c)\n    return sorted(out)\n"
  },
