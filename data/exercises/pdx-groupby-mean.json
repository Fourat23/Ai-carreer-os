  "reference": {
    "solution.py": "import pandas as pd\n\ndef group_mean(rows):\n    df = pd.DataFrame(rows)\n    g = df.groupby('service')['salaire'].mean()\n    return [[s, int(round(v))] for s, v in sorted(g.items())]\n"
  },
