    "solution.py": "def confusion(y_true, y_pred):\n    tp = fp = fn = tn = 0\n    for t, p in zip(y_true, y_pred):\n        if t == 1 and p == 1: tp += 1\n        elif t == 0 and p == 1: fp += 1\n        elif t == 1 and p == 0: fn += 1\n        else: tn += 1\n    return [tp, fp, fn, tn]\n"
  },
