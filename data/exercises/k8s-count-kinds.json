  "reference": {
    "solution.mjs": "export function countKinds(resources){const o={};for(const r of resources)o[r.kind]=(o[r.kind]||0)+1;return o;}"
  },
  "tests": [
    {
      "id": "t1",
      "name": "deux Deployment un Service",
      "kind": "call-equals",
      "export": "countKinds",
      "args": [
        [
          {
            "kind": "Deployment"
          },
          {
            "kind": "Deployment"
          },
          {
            "kind": "Service"
          }
        ]
      ],
      "expected": {
        "Deployment": 2,
        "Service": 1
      }
    },
    {
      "id": "t2",
      "name": "un seul",
      "kind": "call-equals",
      "export": "countKinds",
      "args": [
        [
          {
            "kind": "Pod"
          }
        ]
      ],
      "expected": {
        "Pod": 1
      }
    },
    {
      "id": "t3",
