        "content": "export function runPipeline(lines, steps) {\n  // TODO : appliquer chaque step en ordre (grep/reject/sort/uniq/head/count).\n  return lines;\n}\n"
      }
    ]
  },
  "reference": {
    "solution.mjs": "export function runPipeline(lines,steps){let cur=[...lines];for(const s of steps){if(s.op===\"grep\")cur=cur.filter(l=>l.includes(s.arg));else if(s.op===\"reject\")cur=cur.filter(l=>!l.includes(s.arg));else if(s.op===\"sort\")cur=[...cur].sort();else if(s.op===\"uniq\")cur=cur.filter((l,i)=>i===0||l!==cur[i-1]);else if(s.op===\"head\")cur=cur.slice(0,s.arg);else if(s.op===\"count\")cur=[String(cur.length)];}return cur;}"
  },
