  "tests": [
    {
      "id": "t1",
      "name": "tout géré → SaaS",
      "kind": "call-equals",
      "export": "serviceModel",
      "args": [
        {
          "os": true,
          "runtime": true,
          "app": true
        }
      ],
      "expected": "SaaS"
    },
    {
      "id": "t2",
      "name": "os+runtime → PaaS",
      "kind": "call-equals",
      "export": "serviceModel",
      "args": [
        {
          "os": true,
          "runtime": true,
          "app": false
        }
      ],
      "expected": "PaaS"
    },
    {
      "id": "t3",
      "name": "os seul → IaaS",
      "kind": "call-equals",
      "export": "serviceModel",
      "args": [
