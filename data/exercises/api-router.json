        "/users",
        [
          [
            "GET",
            "/users",
            "list"
          ],
          [
            "POST",
            "/users",
            "create"
          ],
          [
            "GET",
            "/users/:id",
            "show"
          ]
        ]
      ],
      "expected": "list"
    },
