  "reference": {
    "solution.mjs": "export function topoOrder(jobs){const byId=new Map(jobs.map(j=>[j.id,j]));const indeg=new Map(jobs.map(j=>[j.id,0]));for(const j of jobs)for(const d of j.needs||[])if(byId.has(d))indeg.set(j.id,indeg.get(j.id)+1);const out=[];const ready=jobs.filter(j=>indeg.get(j.id)===0).map(j=>j.id);const seen=new Set();while(ready.length){const id=ready.shift();if(seen.has(id))continue;seen.add(id);out.push(id);for(const j of jobs)if((j.needs||[]).includes(id)){indeg.set(j.id,indeg.get(j.id)-1);if(indeg.get(j.id)===0)ready.push(j.id);}}return out;}"
  },
