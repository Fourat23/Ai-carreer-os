        "path": "solution.mjs",
        "content": "export function keyAccepted(octalMode) {\n  // TODO : SSH refuse une clé lisible par le groupe/les autres\n  return octalMode !== '777';\n}\n"
      }
    ]
  },
  "reference": {
    "solution.mjs": "export function keyAccepted(octalMode) {\n  return octalMode === '600' || octalMode === '400';\n}\n"
