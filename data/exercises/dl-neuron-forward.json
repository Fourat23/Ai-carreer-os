  "reference": {
    "solution.py": "import math\n\ndef forward(w, x, b):\n    z = sum(wi * xi for wi, xi in zip(w, x)) + b\n    y = 1 / (1 + math.exp(-z))\n    return f'{y:.3f}'\n"
  },
