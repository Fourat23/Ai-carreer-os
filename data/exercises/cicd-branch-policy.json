  "reference": {
    "solution.mjs": "export function canMerge(policy,pr){const protectedB=policy.protectedBranches||[];if(!protectedB.includes(pr.target))return true;if(policy.requireGreenCI)return pr.ciGreen===true;return true;}"
  },
  "tests": [
    {
      "id": "t1",
      "name": "main protégée, CI verte",
      "kind": "call-equals",
      "export": "canMerge",
      "args": [
        {
          "requireGreenCI": true,
          "protectedBranches": [
            "main"
          ]
        },
        {
          "target": "main",
          "ciGreen": true
        }
