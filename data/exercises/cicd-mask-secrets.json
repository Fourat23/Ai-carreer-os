  "reference": {
    "solution.mjs": "export function maskLog(line,secrets){let out=String(line);for(const s of secrets||[])if(s)out=out.split(String(s)).join(\"***\");return out;}"
  },
  "tests": [
    {
      "id": "t1",
      "name": "un secret masqué",
      "kind": "call-equals",
      "export": "maskLog",
      "args": [
        "deploy token=ghp_abc123",
        [
          "ghp_abc123"
        ]
      ],
      "expected": "deploy token=***"
    },
    {
      "id": "t2",
      "name": "plusieurs occurrences",
      "kind": "call-equals",
      "export": "maskLog",
      "args": [
        "a=SEC b=SEC",
        [
          "SEC"
        ]
      ],
      "expected": "a=*** b=***"
    },
    {
      "id": "t3",
