    { "id": "api-a", "kind": "api", "label": "API (zone A)", "zone": "az-a", "environment": "production", "props": { "replicas": 2, "stateful": false } },
    { "id": "api-b", "kind": "api", "label": "API (zone B)", "zone": "az-b", "environment": "production", "props": { "replicas": 2, "stateful": false } },
    { "id": "cache", "kind": "cache", "label": "Cache partagé", "zone": "az-a", "environment": "production" },
