    "solution.py": "def inner_join(a, b):\n    idx = {r['id']: r['nom'] for r in b}\n    out = []\n    for r in a:\n        if r['id'] in idx:\n            out.append([r['id'], r['nom'], idx[r['id']]])\n    out.sort(key=lambda x: x[0])\n    return out\n"
  },
