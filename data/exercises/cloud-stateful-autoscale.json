    {
      "id": "t2",
      "name": "stateless + autoscaling → ok",
      "kind": "call-equals",
      "export": "isRisky",
      "args": [
        {
          "stateful": false,
          "autoscaling": true
        }
      ],
      "expected": false
    },
    {
      "id": "t3",
      "name": "stateful sans autoscaling → ok",
      "kind": "call-equals",
      "export": "isRisky",
      "args": [
        {
          "stateful": true,
          "autoscaling": false
        }
      ],
      "expected": false
    },
    {
      "id": "t4",
      "name": "ni l'un ni l'autre",
