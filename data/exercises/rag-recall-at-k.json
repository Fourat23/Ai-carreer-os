      {
        "path": "solution.py",
        "content": "def recall_at_k(queries):\n    # TODO : pour chaque requête, relevant dans retrieved[:k] ? moyenne, '%.3f'\n    return '0.000'\n"
      }
    ]
  },
  "reference": {
    "solution.py": "def recall_at_k(queries):\n    if not queries:\n        return '0.000'\n    hits = 0\n    for q in queries:\n        if q['relevant'] in q['retrieved'][:q['k']]:\n            hits += 1\n    return f'{hits/len(queries):.3f}'\n"
  },
