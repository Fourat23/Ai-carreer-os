{
  "id": "unhardened-workload",
  "title": "Workload Kubernetes insuffisamment durci",
  "description": "Un Deployment tourne en root, filesystem inscriptible, capabilities non retirées, image en latest. Objectif : durcir le securityContext et épingler l'image.",
  "domain": "kubernetes",
  "difficulty": 3,
  "incident": "image-untrusted",
  "playbookRef": "kubernetes-incident",
  "artifacts": [
    {
      "id": "deploy",
      "kind": "manifest",
      "path": "k8s/deploy.json",
      "content": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "api",
          "namespace": "prod"
        },
        "exposeNote": "no-networkpolicy",
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "name": "api",
                  "image": "registry/api:latest",
                  "securityContext": {
                    "capabilities": {
                      "add": [
                        "NET_ADMIN"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "fixedArtifacts": [
    {
      "id": "deploy",
      "kind": "manifest",
      "path": "k8s/deploy.json",
      "content": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "api",
          "namespace": "prod"
        },
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "name": "api",
                  "image": "registry/api@sha256:aaabbbcccdddeeefff",
                  "securityContext": {
                    "runAsNonRoot": true,
                    "runAsUser": 1000,
                    "readOnlyRootFilesystem": true,
                    "capabilities": {
                      "drop": [
                        "ALL"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "skills": [
    "linux",
    "testing"
  ],
  "dayRefs": [
    85
  ],
  "trackScope": [
    "systems-cloud-foundations-v1"
  ],
  "missionRefs": [
    "sec-workload-hardening"
  ]
}
