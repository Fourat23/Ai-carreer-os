  "reference": {
    "solution.mjs": "export function pinned(image){const ref=image.split(\"/\").pop();if(!ref.includes(\":\"))return false;const tag=ref.split(\":\").pop();return tag!==\"latest\"&&tag.length>0;}"
  },
  "tests": [
    {
      "id": "t1",
      "name": "version épinglée",
      "kind": "call-equals",
      "export": "pinned",
      "args": [
        "registry/app:1.2.3"
      ],
      "expected": true
    },
    {
      "id": "t2",
      "name": "latest → non",
      "kind": "call-equals",
      "export": "pinned",
      "args": [
        "registry/app:latest"
      ],
      "expected": false
    },
    {
      "id": "t3",
      "name": "sans tag → non",
      "kind": "call-equals",
      "export": "pinned",
      "args": [
        "registry/app"
      ],
      "expected": false
    },
    {
      "id": "t4",
      "name": "tag court",
