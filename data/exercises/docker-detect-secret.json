  "id": "docker-detect-secret",
  "title": "Docker : repérer un secret exposé",
  "difficulty": 3,
  "summary": "Analyse STATIQUE. findSecretLeaks(lines) renvoie les index (0-based) des lignes qui exposent un secret dans l’image : ENV/ARG d’une clé (API_KEY, TOKEN, SECRET, PASSWORD) avec valeur, ou COPY d’un .env. Une variable SANS valeur n’est pas une fuite.",
  "skills": [
    "linux",
    "debugging"
  ],
  "workspace": {
    "entry": "solution.mjs",
    "files": [
      {
        "path": "solution.mjs",
        "content": "export function findSecretLeaks(lines) {\n  // TODO : index des lignes ENV/ARG SECRET=valeur ou COPY .env.\n  return [];\n}\n"
      }
    ]
  },
  "reference": {
    "solution.mjs": "export function findSecretLeaks(lines){const out=[];lines.forEach((l,i)=>{const u=l.toUpperCase();if(/^\\s*(ENV|ARG)\\s+\\w*(API_KEY|TOKEN|SECRET|PASSWORD)\\w*\\s*=\\s*\\S+/.test(u))out.push(i);else if(/^\\s*COPY\\s+.*\\.ENV(\\s|$)/.test(u))out.push(i);});return out;}"
  },
  "tests": [
    {
      "id": "t1",
      "name": "ENV API_KEY=xxx détecté",
      "kind": "call-equals",
      "export": "findSecretLeaks",
      "args": [
        [
          "FROM node:20",
          "ENV API_KEY=sk-123",
          "CMD node app"
        ]
      ],
      "expected": [
        1
      ]
    },
    {
      "id": "t2",
      "name": "COPY .env détecté",
      "kind": "call-equals",
      "export": "findSecretLeaks",
      "args": [
        [
          "FROM node",
          "COPY .env /app/.env"
        ]
      ],
      "expected": [
        1
      ]
    },
    {
      "id": "t3",
      "name": "ARG TOKEN sans valeur → rien",
      "kind": "call-equals",
      "export": "findSecretLeaks",
      "args": [
        [
          "ARG TOKEN",
          "FROM node"
        ]
      ],
      "expected": []
    },
