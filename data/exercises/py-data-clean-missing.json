      {
        "path": "solution.py",
        "content": "def clean(values):\n    # TODO : ignorer les None (pas les traiter comme 0), renvoyer [count, sum]\n    return [len(values), sum(values)]\n"
      }
    ]
  },
  "reference": {
    "solution.py": "def clean(values):\n    valid = [v for v in values if v is not None]\n    return [len(valid), sum(valid)]\n"
  },
