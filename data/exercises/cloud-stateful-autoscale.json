  "tests": [
    {
      "id": "t1",
      "name": "stateful + autoscaling → risque",
      "kind": "call-equals",
      "export": "isRisky",
      "args": [
        {
          "stateful": true,
          "autoscaling": true
        }
      ],
      "expected": true
